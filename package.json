{
  "name": "vera",
  "version": "2.0.0",
  "description": "",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build:web && npm run build:server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint src server shared tests",
    "test": "vitest run",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist-server/server/src/index.js",
    "reset-password": "tsx server/src/cli/reset-password.ts",
    "build:web": "tsc --noEmit && vite build",
    "reset-data": "tsx server/src/cli/wipe-data.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^2.31.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.61.0",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "allowScripts": {
    "@google/genai@2.31.0": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true
  }
}
