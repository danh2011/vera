# Copy to .env (never commit it). Placeholders only: real keys go in your own .env on the server.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Where the SQLite database, secret key and uploads live. In Docker this is the mounted /data volume.
VERA_DATA_DIR=./data
# VERA_DATABASE_PATH=./data/vera.db

# The address you type in the browser. Must be https:// in production (terminate TLS at Nginx Proxy Manager).
# In development with `npm run dev` set it to http://localhost:5173 so the OAuth redirect comes back to Vite.
VERA_PUBLIC_URL=http://localhost:3001
# VERA_ALLOWED_ORIGINS=            # extra trusted browser origins, comma separated

VERA_AUTH_REQUIRED=true            # must stay true; Vera has no unauthenticated mode
# VERA_SETUP_TOKEN=                # optional fixed first-run setup code (min 12 chars); otherwise one is printed at startup

# Reverse proxy. Only enable behind Nginx Proxy Manager. Forwarded headers are trusted ONLY from these networks.
VERA_TRUSTED_PROXY=false
# VERA_TRUSTED_PROXY_CIDRS=172.18.0.0/16

# Encryption key for stored integration credentials (base64, 32 bytes): openssl rand -base64 32
# If unset, a key file is created at $VERA_DATA_DIR/secret.key. Keep the key OUTSIDE your database backups for real separation.
# VERA_SECRET_KEY=
# VERA_SECRET_KEY_FILE=

# ---- Gemini (optional; Vera's local features work without it) ----
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Choose a model from Google's CURRENT model list. Vera deliberately has no default so it never upgrades you silently.
GEMINI_MODEL=
# Vera's own cost guards (the effective limit is the lower of these and anything set in Settings)
VERA_MAX_REQUESTS_PER_MINUTE=10
VERA_MAX_REQUESTS_PER_DAY=200
VERA_MAX_TOOL_ROUNDS=4
VERA_MAX_INPUT_CHARS=8000
VERA_MAX_OUTPUT_TOKENS=1024
VERA_AI_TIMEOUT_MS=30000

# ---- File access (read-only), comma separated absolute paths. Empty = file tools unavailable. ----
VERA_ALLOWED_FILE_ROOTS=

# ---- Read-only machine diagnostics ----
VERA_ENABLE_MACHINE_READONLY=false
# VERA_DISK_PATHS=/data,/media      # paths whose capacity may be reported (default: the data folder)
# VERA_DOCKER_PROXY_URL=http://docker-proxy:2375   # a READ-ONLY docker socket proxy; Vera never mounts docker.sock

VERA_LOG_LEVEL=info
