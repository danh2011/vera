# ==========================================================
# Vera V0.1 - Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit your real .env file.
# ==========================================================

# --- AI Provider (Google Gemini) ---
# Required. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-1.5-flash if unset.
GEMINI_MODEL=gemini-1.5-flash

# --- Server ---
# Port the Express API server listens on.
PORT=3001
# Set to "development" or "production".
NODE_ENV=development

# --- Database ---
# Path to the SQLite database file (created automatically).
DATABASE_PATH=./data/vera.db

# --- Vera Workspace ---
# Directory the Files/Notes/Code capabilities are allowed to read/write.
# All access is sandboxed to this directory - path traversal is blocked.
WORKSPACE_PATH=./data/workspace

# --- Web Search ---
# Optional. If unset, the Web Search capability will return a friendly
# "not configured" message instead of failing.
# Supported provider: "brave" (https://brave.com/search/api/)
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Weather ---
# Optional. Uses Open-Meteo (no key required) if unset.
# Supported provider: "openweathermap"
WEATHER_PROVIDER=
WEATHER_API_KEY=
# Default location used when the user doesn't specify one, e.g. "London,UK"
WEATHER_DEFAULT_LOCATION=

# --- Updates ---
# GitHub "owner/repo" slug used to check for new releases.
UPDATE_REPO=

# --- Developer Mode ---
# Set to "true" to expose the developer/debug panel in the UI.
DEV_MODE=false
